#!/usr/bin/env bash
# Portable WNF verification. Repo root is derived from this file, never cwd.
set -euo pipefail

_SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "${_SCRIPT_DIR}/.." && pwd)
cd "$REPO_ROOT"

PROJECT="WNF.xcodeproj"
SCHEME="WNF"
# Default device and runtime live only here. DESTINATION is derived from them
# unless WNF_DESTINATION selects another supported iOS Simulator target.
DEFAULT_SIM_NAME="iPhone 17"
DEFAULT_IOS_RUNTIME="26.5"
DEST_MODE="name"
SIM_NAME="$DEFAULT_SIM_NAME"
IOS_RUNTIME_VERSION="$DEFAULT_IOS_RUNTIME"
SIM_ID=""
DESTINATION="platform=iOS Simulator,name=${DEFAULT_SIM_NAME},OS=${DEFAULT_IOS_RUNTIME}"
ASC_APP_ID="6780135826"
EDITABLE_ASC_VERSION="1.2"

VERIFY_DIR="${REPO_ROOT}/build/verification"
RUN_ID=""
RUN_DIR=""
MANIFEST=""
DERIVED_DATA=""
LOG_DIR=""
RESULT_DIR=""
PRODUCTS_DIR=""

SWIFT_FLAGS=(
  SWIFT_TREAT_WARNINGS_AS_ERRORS=YES
  SWIFT_STRICT_CONCURRENCY=complete
)
UNSIGNED_FLAGS=(
  CODE_SIGNING_ALLOWED=NO
  CODE_SIGNING_REQUIRED=NO
  CODE_SIGN_IDENTITY=
)

IN_VERIFY=0
SUMMARY_LINES=""
STAGE_NAME=""
STAGE_START=0
STAGE_BUNDLE=""
STAGE_LOG=""

usage() {
  cat <<'EOF'
Usage: ./scripts/wnf <command>

  doctor         Read-only environment check (developer dir, commands, Metal toolchain,
                 selected simulator, 4 targets, tracked scheme). Stops before any build.
  bootstrap      Ensure the selected iOS Simulator exists. Name mode creates it when the
                 runtime is already installed. Id mode only validates that id.
  static-gate    Tracked-file, project membership, version, doc link, font, plist, metadata, and resource checks used by verify
  build          Debug App+Widget
  test-unit      WNFTests
  test-ui        WNFUITests
  analyze        xcodebuild analyze
  release-check  Unsigned Release simulator build + bundle audit
  verify         doctor → bootstrap → static-gate → build → test-unit → test-ui → analyze → release-check
  store-check    OPTIONAL. Read-only ASC metadata pull/validate/plan + URL/screenshot presence.
                 Never apply, submit, or remote-delete. Not part of verify.

  WNF_DESTINATION  Optional simulator override. Two forms are accepted:
                     platform=iOS Simulator,name=<device>,OS=<version>
                     platform=iOS Simulator,id=<udid>
                   Any other form is an error. The default is iPhone 17 on iOS 26.5.
                   Name and OS overrides are shared by doctor and bootstrap.

Each command creates build/verification/runs/<run-id>/ with manifest.json,
logs, results, products, and DerivedData. build/verification/latest points at
that run, including a failed one. Older runs stay where they are.

A machine that already has the required Xcode components can start this flow
and see a failing stage immediately. Downloading Xcode, a runtime, or the
Metal toolchain is separate and is not done by this script.
EOF
}

relpath() {
  local p="$1"
  case "$p" in
    "${REPO_ROOT}"/*) printf '%s\n' "${p#"${REPO_ROOT}"/}" ;;
    *) printf '%s\n' "$p" ;;
  esac
}

now_s() {
  date +%s
}

ensure_dirs() {
  mkdir -p "$LOG_DIR" "$RESULT_DIR" "$PRODUCTS_DIR" "$DERIVED_DATA"
}

begin_run() {
  local command_name="$1"
  local lines=""
  lines=$(python3 - "$REPO_ROOT" "$command_name" "$VERIFY_DIR" "$DESTINATION" <<'PY'
import json, os, subprocess, sys, uuid
from datetime import datetime

repo, command_name, verify_dir, destination = sys.argv[1:5]
now = datetime.now().astimezone()
commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=repo, text=True).strip()
short = subprocess.check_output(["git", "rev-parse", "--short=12", "HEAD"], cwd=repo, text=True).strip()
porcelain = subprocess.check_output(["git", "status", "--porcelain"], cwd=repo, text=True)
try:
    xcode_raw = subprocess.check_output(["xcodebuild", "-version"], text=True, stderr=subprocess.STDOUT)
    xcode_version = " ".join(line.strip() for line in xcode_raw.splitlines() if line.strip())
except (OSError, subprocess.CalledProcessError) as exc:
    xcode_version = "unavailable (%s)" % exc

run_id = "%s-%s-%s" % (now.strftime("%Y%m%dT%H%M%S%z"), short, uuid.uuid4().hex[:8])
run_dir = os.path.join(verify_dir, "runs", run_id)
for name in ("logs", "results", "products", "DerivedData"):
    os.makedirs(os.path.join(run_dir, name), exist_ok=True)

stages = {
    "doctor": "not_run",
    "bootstrap": "not_run",
    "static-gate": "not_run",
    "build": "not_run",
    "test-unit": "not_run",
    "test-ui": "not_run",
    "analyze": "not_run",
    "release-check": "not_run",
}
if command_name == "store-check":
    stages["store-check"] = "not_run"

manifest = {
    "run_id": run_id,
    "command": command_name,
    "commit": commit,
    "dirty": bool(porcelain.strip()),
    "started_at": now.isoformat(timespec="seconds"),
    "xcode_version": xcode_version,
    "destination": destination,
    "overall_status": "running",
    "stages": stages,
}
manifest_path = os.path.join(run_dir, "manifest.json")
with open(manifest_path, "w", encoding="utf-8") as fh:
    json.dump(manifest, fh, indent=2, ensure_ascii=False)
    fh.write("\n")

latest = os.path.join(verify_dir, "latest")
if os.path.islink(latest) or not os.path.lexists(latest):
    if os.path.lexists(latest):
        os.remove(latest)
    os.symlink(os.path.join("runs", run_id), latest)
else:
    sys.stderr.write("build/verification/latest exists and is not a symlink; left it untouched\n")

print(run_id)
print(run_dir)
PY
)
  RUN_ID=$(printf '%s\n' "$lines" | sed -n '1p')
  RUN_DIR=$(printf '%s\n' "$lines" | sed -n '2p')
  LOG_DIR="${RUN_DIR}/logs"
  RESULT_DIR="${RUN_DIR}/results"
  PRODUCTS_DIR="${RUN_DIR}/products"
  DERIVED_DATA="${RUN_DIR}/DerivedData"
  MANIFEST="${RUN_DIR}/manifest.json"
  trap 'on_exit' EXIT
  printf 'run: %s\n' "$(relpath "$RUN_DIR")"
}

manifest_mark() {
  local stage="$1"
  local status="$2"
  if [[ -z "$MANIFEST" || ! -f "$MANIFEST" ]]; then
    return 0
  fi
  python3 - "$MANIFEST" "$stage" "$status" <<'PY'
import json, os, sys

path, stage, status = sys.argv[1:4]
with open(path, encoding="utf-8") as fh:
    data = json.load(fh)
data.setdefault("stages", {})[stage] = status
if status == "failed":
    data["overall_status"] = "failed"
temporary = path + ".tmp"
with open(temporary, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2, ensure_ascii=False)
    fh.write("\n")
os.replace(temporary, path)
PY
}

manifest_finalize() {
  local rc="$1"
  if [[ -z "$MANIFEST" || ! -f "$MANIFEST" ]]; then
    return 0
  fi
  python3 - "$MANIFEST" "$rc" <<'PY'
import json, os, sys
from datetime import datetime

path, rc_text = sys.argv[1], sys.argv[2]
rc = int(rc_text)
with open(path, encoding="utf-8") as fh:
    data = json.load(fh)
stages = data.setdefault("stages", {})
for name, status in list(stages.items()):
    if status == "running":
        stages[name] = "failed" if rc != 0 else "passed"
if rc != 0 or any(status == "failed" for status in stages.values()):
    data["overall_status"] = "failed"
else:
    data["overall_status"] = "passed"
data["exit_code"] = rc
data["finished_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
temporary = path + ".tmp"
with open(temporary, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2, ensure_ascii=False)
    fh.write("\n")
os.replace(temporary, path)
PY
}

on_exit() {
  local rc=$?
  manifest_finalize "$rc" || true
  if [[ "$IN_VERIFY" -eq 1 ]]; then
    print_verify_summary "$rc"
  fi
}

append_summary() {
  local name="$1" status="$2" elapsed="$3" bundle="$4"
  local bundle_disp="-"
  if [[ -n "$bundle" ]]; then
    bundle_disp=$(relpath "$bundle")
  fi
  SUMMARY_LINES="${SUMMARY_LINES}$(printf '%-14s %-4s %5ss  %s' "$name" "$status" "$elapsed" "$bundle_disp")"$'\n'
}

print_verify_summary() {
  local rc="${1:-$?}"
  local elapsed=0
  if [[ -n "${VERIFY_START:-}" ]]; then
    elapsed=$(( $(now_s) - VERIFY_START ))
  fi
  printf '\n======== WNF verify summary ========\n'
  if [[ -n "$SUMMARY_LINES" ]]; then
    printf '%s' "$SUMMARY_LINES"
  fi
  if [[ $rc -eq 0 && "$IN_VERIFY" -eq 1 ]]; then
    printf 'ALL PASSED  (%ss)\n' "$elapsed"
  else
    printf 'FAILED  (%ss)\n' "$elapsed"
  fi
}

stage_start() {
  STAGE_NAME="$1"
  STAGE_BUNDLE="${2:-}"
  STAGE_LOG="${3:-}"
  STAGE_START=$(now_s)
  ensure_dirs
  printf '\n==> %s\n' "$STAGE_NAME"
  if [[ -n "$STAGE_LOG" ]]; then
    printf '    log: %s\n' "$(relpath "$STAGE_LOG")"
  fi
  if [[ -n "$STAGE_BUNDLE" ]]; then
    printf '    result-bundle: %s\n' "$(relpath "$STAGE_BUNDLE")"
  fi
  manifest_mark "$STAGE_NAME" "running"
}

print_diag() {
  local log="${1:-$STAGE_LOG}"
  local pattern='error: |fatal error: |\*\* .*FAILED \*\*|Testing failed|ANALYZE FAILED|The following build commands failed|xcodebuild: error:'
  if [[ -z "$log" || ! -f "$log" ]]; then
    printf '    (no log)\n'
    return 0
  fi
  printf '    log: %s\n' "$(relpath "$log")"
  printf '%s\n' '--- diagnostic ---'
  # First match is the root error; later lines are usually cascade.
  if grep -E "$pattern" "$log" >/dev/null 2>&1; then
    grep -n -E -C 8 -m 1 "$pattern" "$log" || true
    printf '%s\n' '--- first errors ---'
    grep -n -E "$pattern" "$log" | head -n 20 || true
  else
    # Audit / "app not found" notes are appended after a green xcodebuild.
    tail -n 40 "$log"
  fi
  printf '%s\n' '-------------------'
}

stage_finish() {
  local status="$1"
  local rc="${2:-0}"
  local elapsed=$(( $(now_s) - STAGE_START ))
  local bundle_disp="-"
  if [[ -n "$STAGE_BUNDLE" ]]; then
    bundle_disp=$(relpath "$STAGE_BUNDLE")
  fi
  printf '%s  %s  %ss  result-bundle: %s\n' "$status" "$STAGE_NAME" "$elapsed" "$bundle_disp"
  append_summary "$STAGE_NAME" "$status" "$elapsed" "$STAGE_BUNDLE"
  if [[ "$status" != PASS ]]; then
    manifest_mark "$STAGE_NAME" "failed"
    print_diag "$STAGE_LOG"
    exit "$rc"
  fi
  manifest_mark "$STAGE_NAME" "passed"
}

fail_stage() {
  local rc="${1:-1}"
  stage_finish FAIL "$rc"
}

require_cmd() {
  local name="$1"
  if ! command -v "$name" >/dev/null 2>&1; then
    printf 'FAIL  missing command: %s\n' "$name"
    exit 1
  fi
}

xcode_common() {
  # Args after configuration and log/bundle are forwarded to xcodebuild.
  local configuration="$1"
  local log="$2"
  local bundle="$3"
  shift 3

  local signing_flags=("${UNSIGNED_FLAGS[@]}")
  if [[ "$configuration" == Debug ]]; then
    # Simulator ad-hoc signing needs no certificate/account, but preserves
    # App Group entitlements so App and Widget actually share their snapshot.
    signing_flags=(CODE_SIGNING_ALLOWED=YES CODE_SIGNING_REQUIRED=YES CODE_SIGN_IDENTITY=-)
  fi

  rm -rf "$bundle"
  mkdir -p "$(dirname "$log")" "$(dirname "$bundle")" "$DERIVED_DATA"

  set +e
  xcodebuild \
    -project "$PROJECT" \
    -scheme "$SCHEME" \
    -configuration "$configuration" \
    -destination "$DESTINATION" \
    -derivedDataPath "$DERIVED_DATA" \
    -resultBundlePath "$bundle" \
    "${SWIFT_FLAGS[@]}" \
    "${signing_flags[@]}" \
    COMPILER_INDEX_STORE_ENABLE=NO \
    "$@" \
    >"$log" 2>&1
  local rc=$?
  set -e
  return $rc
}

run_xcodebuild_stage() {
  local stage="$1"
  local configuration="$2"
  shift 2
  local log="${LOG_DIR}/${stage}.log"
  local bundle="${RESULT_DIR}/${stage}.xcresult"
  stage_start "$stage" "$bundle" "$log"
  local rc=0
  xcode_common "$configuration" "$log" "$bundle" "$@" || rc=$?
  if [[ $rc -ne 0 ]]; then
    fail_stage "$rc"
  fi
  stage_finish PASS 0
}

tracked_scheme_files() {
  git ls-files '*.xcscheme'
}

expected_scheme() {
  printf '%s\n' 'WNF.xcodeproj/xcshareddata/xcschemes/WNF.xcscheme'
}

list_project_targets() {
  xcodebuild -list -project "$PROJECT" | awk '
    /^[[:space:]]*Targets:/ { p=1; next }
    /^[[:space:]]*Build Configurations:/ { p=0 }
    p {
      gsub(/\r/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      if ($0 != "") print
    }
  ' | sort
}

expected_targets() {
  printf '%s\n' WNF WNFTests WNFUITests WNFWidget
}

check_four_targets() {
  local got expected
  got=$(list_project_targets)
  expected=$(expected_targets)
  if [[ "$got" != "$expected" ]]; then
    printf 'expected targets:\n%s\nactual:\n%s\n' "$expected" "$got"
    return 1
  fi
  return 0
}

check_tracked_scheme() {
  local got expected
  got=$(tracked_scheme_files)
  expected=$(expected_scheme)
  if [[ "$got" != "$expected" ]]; then
    printf 'expected tracked scheme:\n%s\nactual:\n%s\n' "$expected" "$got"
    return 1
  fi
  return 0
}

# Needles are split so this file itself does not contain the forbidden substrings.
forbidden_needles_python() {
  python3 - "$REPO_ROOT" <<'PY'
import subprocess, sys

repo = sys.argv[1]
needles = [
    "/" + "Users" + "/",
    "simulator" + "Id:",
    "applinks" + ":" + "wonangfei.app",
]
failed = False
for needle in needles:
    proc = subprocess.run(
        ["git", "grep", "-n", "-F", needle, "--", "."],
        cwd=repo,
        capture_output=True,
        text=True,
    )
    if proc.returncode == 0 and proc.stdout.strip():
        failed = True
        sys.stderr.write("forbidden substring %r in tracked files:\n%s\n" % (needle, proc.stdout))
    elif proc.returncode not in (0, 1):
        failed = True
        sys.stderr.write(proc.stderr or proc.stdout or "git grep failed\n")
sys.exit(1 if failed else 0)
PY
}

parse_and_check_tree_python() {
  python3 - "$REPO_ROOT" <<'PY'
import json
import os
import plistlib
import sys

repo = sys.argv[1]
errors = []

def err(msg):
    errors.append(msg)

def load_plist(rel):
    path = os.path.join(repo, rel)
    if not os.path.isfile(path):
        err("missing " + rel)
        return None
    with open(path, "rb") as fh:
        return plistlib.load(fh)

def load_json(rel):
    path = os.path.join(repo, rel)
    if not os.path.isfile(path):
        err("missing " + rel)
        return None
    with open(path, "r", encoding="utf-8") as fh:
        try:
            return json.load(fh)
        except json.JSONDecodeError as exc:
            err("%s: invalid JSON (%s)" % (rel, exc))
            return None

info = load_plist("WNF/Info.plist")
if info is not None:
    if info.get("CFBundleDisplayName") != "窝囊费":
        err("Info.plist CFBundleDisplayName")
    if info.get("ITSAppUsesNonExemptEncryption") is not False:
        err("Info.plist ITSAppUsesNonExemptEncryption must be false")
    if info.get("NSSupportsLiveActivities") is not True:
        err("Info.plist NSSupportsLiveActivities")
    if info.get("LSApplicationCategoryType") != "public.app-category.finance":
        err("Info.plist LSApplicationCategoryType")
    fonts = info.get("UIAppFonts") or []
    expected_fonts = [
        "ZCOOLQingKeHuangYou-Regular.ttf",
        "JetBrainsMono-Regular.ttf",
        "JetBrainsMono-Bold.ttf",
    ]
    if list(fonts) != expected_fonts:
        err("Info.plist UIAppFonts: %s" % (fonts,))
    orients = info.get("UISupportedInterfaceOrientations") or []
    if list(orients) != ["UIInterfaceOrientationPortrait"]:
        err("Info.plist UISupportedInterfaceOrientations")
    if not info.get("NSPhotoLibraryAddUsageDescription"):
        err("Info.plist NSPhotoLibraryAddUsageDescription")

widget_info = load_plist("WNFWidget/Info.plist")
if widget_info is not None:
    if widget_info.get("CFBundleDisplayName") != "窝囊费小组件":
        err("WNFWidget Info.plist CFBundleDisplayName")
    ext = (widget_info.get("NSExtension") or {}).get("NSExtensionPointIdentifier")
    if ext != "com.apple.widgetkit-extension":
        err("WNFWidget NSExtensionPointIdentifier")

def check_entitlements(rel):
    data = load_plist(rel)
    if data is None:
        return
    groups = data.get("com.apple.security.application-groups") or []
    if "group.com.wonangfei.app" not in list(groups):
        err("%s missing App Group" % rel)
    for key in data:
        if "associated-domains" in str(key):
            err("%s must not contain Associated Domains (%s)" % (rel, key))

check_entitlements("WNF/WNF.entitlements")
check_entitlements("WNFWidget/WNFWidget.entitlements")

privacy = load_plist("WNF/PrivacyInfo.xcprivacy")
if privacy is not None:
    if privacy.get("NSPrivacyTracking") is not False:
        err("PrivacyInfo NSPrivacyTracking")
    if list(privacy.get("NSPrivacyTrackingDomains") or []) != []:
        err("PrivacyInfo NSPrivacyTrackingDomains must be empty")
    if list(privacy.get("NSPrivacyCollectedDataTypes") or []) != []:
        err("PrivacyInfo NSPrivacyCollectedDataTypes must be empty")
    reasons_ok = False
    for entry in privacy.get("NSPrivacyAccessedAPITypes") or []:
        if entry.get("NSPrivacyAccessedAPIType") == "NSPrivacyAccessedAPICategoryUserDefaults":
            if "CA92.1" in list(entry.get("NSPrivacyAccessedAPITypeReasons") or []):
                reasons_ok = True
    if not reasons_ok:
        err("PrivacyInfo missing UserDefaults CA92.1")

current_marketing = "https://rottesya.github.io/wonangfei/"
current_support = "https://rottesya.github.io/wonangfei/support.html"
privacy_url = "https://rottesya.github.io/wonangfei/privacy.html"
required_keys = ("description", "keywords", "marketingUrl", "supportUrl")
expected_version_urls = {
    # READY_FOR_DISTRIBUTION versions are immutable ASC snapshots. Keep their
    # pulled historical values instead of rewriting them to today's website.
    "1.0": (
        "https://rottesya.github.io/wonangfei-legal/",
        "https://rottesya.github.io/wonangfei-legal/support.html",
    ),
    "1.1": (current_marketing, current_support),
    # 1.2 is the only editable version and must use the current public URLs.
    "1.2": (current_marketing, current_support),
}
for ver in ("1.0", "1.1", "1.2"):
    rel = "metadata/version/%s/zh-Hans.json" % ver
    payload = load_json(rel)
    if payload is None:
        continue
    for key in required_keys:
        if not payload.get(key):
            err("%s missing %s" % (rel, key))
    expected_marketing, expected_support = expected_version_urls[ver]
    if payload.get("marketingUrl") != expected_marketing:
        err("%s marketingUrl" % rel)
    if payload.get("supportUrl") != expected_support:
        err("%s supportUrl" % rel)

app_info = load_json("metadata/app-info/zh-Hans.json")
if app_info is not None and app_info.get("privacyPolicyUrl") != privacy_url:
    err("metadata/app-info/zh-Hans.json privacyPolicyUrl")

if errors:
    sys.stderr.write("\n".join(errors) + "\n")
    sys.exit(1)
PY
}

sips_field() {
  local file="$1"
  local key="$2"
  sips -g "$key" "$file" 2>/dev/null | awk -v k="$key" '$1 == k ":" { print $2; exit }'
}

check_onboarding_images() {
  local names=(
    OnboardingP1
    OnboardingP2
    OnboardingP4
    OnboardingLunchSleep
    OnboardingLunchWake
  )
  local name dir png w h alpha found
  for name in "${names[@]}"; do
    dir="WNF/Assets.xcassets/${name}.imageset"
    if [[ ! -d "$dir" ]]; then
      printf 'missing imageset %s\n' "$dir"
      return 1
    fi
    found=0
    for png in "$dir"/*.png; do
      [[ -f "$png" ]] || continue
      found=1
      w=$(sips_field "$png" pixelWidth)
      h=$(sips_field "$png" pixelHeight)
      alpha=$(sips_field "$png" hasAlpha)
      if [[ "$w" != 1536 || "$h" != 1024 || "$alpha" != yes ]]; then
        printf '%s expected 1536x1024 + alpha, got %sx%s hasAlpha=%s\n' "$png" "$w" "$h" "$alpha"
        return 1
      fi
    done
    if [[ "$found" -eq 0 ]]; then
      printf 'no PNG in %s\n' "$dir"
      return 1
    fi
  done
  return 0
}

check_canonical_files() {
  local missing=0
  local f
  for f in \
    docs/privacy.html \
    docs/terms.html \
    docs/acknowledgements.html \
    WNF/Fonts/ZCOOLQingKeHuangYou-Regular.ttf \
    WNF/Fonts/JetBrainsMono-Regular.ttf \
    WNF/Fonts/JetBrainsMono-Bold.ttf
  do
    if [[ ! -f "$f" ]]; then
      printf 'missing %s\n' "$f"
      missing=1
    fi
  done
  return "$missing"
}

git_diff_check() {
  local out rc=0 base_ref="" merge_base="" head=""
  set +e
  out=$(git diff --check 2>&1)
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    printf '%s\n' "$out"
    return 1
  fi
  set +e
  out=$(git diff --cached --check 2>&1)
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    printf '%s\n' "$out"
    return 1
  fi

  # A clean checkout has no working-tree diff, so also inspect everything the
  # current branch introduced relative to main. WNF_DIFF_BASE supports forks
  # whose default branch uses a different ref.
  if [[ -n "${WNF_DIFF_BASE:-}" ]]; then
    base_ref="$WNF_DIFF_BASE"
  elif git rev-parse --verify --quiet 'origin/main^{commit}' >/dev/null; then
    base_ref="origin/main"
  elif git rev-parse --verify --quiet 'main^{commit}' >/dev/null; then
    base_ref="main"
  fi

  if [[ -n "$base_ref" ]]; then
    set +e
    merge_base=$(git merge-base "$base_ref" HEAD 2>/dev/null)
    rc=$?
    set -e
    if [[ $rc -ne 0 || -z "$merge_base" ]]; then
      printf 'cannot resolve merge-base for %s and HEAD\n' "$base_ref"
      return 1
    fi
    head=$(git rev-parse HEAD)
    if [[ "$merge_base" != "$head" ]]; then
      set +e
      out=$(git diff --check "${merge_base}..HEAD" 2>&1)
      rc=$?
      set -e
      if [[ $rc -ne 0 ]]; then
        printf '%s\n' "$out"
        return 1
      fi
    fi
  fi

  # After the branch is merged, base and HEAD can be identical. Keep the gate
  # useful by rejecting trailing horizontal whitespace in every tracked text file.
  set +e
  out=$(git grep -n -I -E '[[:blank:]]+$' -- . 2>&1)
  rc=$?
  set -e
  if [[ $rc -eq 0 ]]; then
    printf 'tracked files contain trailing whitespace:\n%s\n' "$out"
    return 1
  fi
  if [[ $rc -ne 1 ]]; then
    printf '%s\n' "$out"
    return 1
  fi
  return 0
}

find_release_app() {
  local products="${DERIVED_DATA}/Build/Products/Release-iphonesimulator"
  if [[ -d "${products}/WNF.app" ]]; then
    printf '%s\n' "${products}/WNF.app"
    return 0
  fi
  local found=""
  if [[ -d "$products" ]]; then
    found=$(find "$products" -maxdepth 1 -name '*.app' -print 2>/dev/null | sed -n '1p')
  fi
  if [[ -n "$found" ]]; then
    printf '%s\n' "$found"
    return 0
  fi
  return 1
}

audit_release_bundle() {
  local app="$1"
  local missing=0
  local name
  if [[ ! -d "$app" ]]; then
    printf 'Release .app not found: %s\n' "$app"
    return 1
  fi
  # Bundle.main.url(forResource:) and UIAppFonts resolve these at the app root.
  for name in \
    ZCOOLQingKeHuangYou-Regular.ttf \
    JetBrainsMono-Regular.ttf \
    JetBrainsMono-Bold.ttf \
    home-typing.mov \
    privacy.html \
    terms.html \
    acknowledgements.html \
    PrivacyInfo.xcprivacy
  do
    if [[ ! -f "${app}/${name}" ]]; then
      printf 'app root missing %s\n' "$name"
      missing=1
    fi
  done
  local bored=""
  bored=$(find "$app" -name 'home-bored.mov' -print 2>/dev/null | sed -n '1p')
  if [[ -n "$bored" ]]; then
    printf 'bundle still contains home-bored.mov: %s\n' "$bored"
    missing=1
  fi
  if [[ ! -d "${app}/PlugIns/WNFWidget.appex" ]]; then
    printf 'bundle missing PlugIns/WNFWidget.appex\n'
    missing=1
  fi
  local metallib=""
  metallib=$(find "$app" -maxdepth 1 -name '*.metallib' -print 2>/dev/null | sed -n '1p')
  if [[ -z "$metallib" ]]; then
    printf 'app root missing metallib\n'
    missing=1
  fi
  for name in privacy.html terms.html acknowledgements.html; do
    if [[ ! -f "${app}/${name}" ]]; then
      continue
    fi
    if ! cmp -s "${app}/${name}" "${REPO_ROOT}/docs/${name}"; then
      printf 'bundle %s differs from docs/%s\n' "$name" "$name"
      missing=1
    fi
  done
  python3 - "$app" <<'PY'
import os
import sys

app = sys.argv[1]
names = [
    "ZCOOLQingKeHuangYou-Regular.ttf",
    "JetBrainsMono-Regular.ttf",
    "JetBrainsMono-Bold.ttf",
    "home-typing.mov",
    "privacy.html",
    "terms.html",
    "acknowledgements.html",
    "PrivacyInfo.xcprivacy",
]
print("resource bytes:")
for name in names:
    path = os.path.join(app, name)
    if os.path.isfile(path):
        print("  %s %d" % (name, os.path.getsize(path)))
for name in sorted(os.listdir(app)):
    if name.endswith(".metallib"):
        print("  %s %d" % (name, os.path.getsize(os.path.join(app, name))))
total = 0
for root, _dirs, files in os.walk(app):
    for filename in files:
        path = os.path.join(root, filename)
        try:
            total += os.path.getsize(path)
        except OSError:
            pass
print("simulator app file bytes: %d" % total)
print("simulator .app file bytes are not an IPA size")
PY
  return "$missing"
}

resolve_destination() {
  local assignments="" rc=0
  set +e
  assignments=$(python3 - "$DEFAULT_SIM_NAME" "$DEFAULT_IOS_RUNTIME" <<'PY'
import os, shlex, sys

default_name, default_os = sys.argv[1], sys.argv[2]
raw = os.environ.get("WNF_DESTINATION", "").strip()

def fail(msg):
    sys.stderr.write(msg + "\n")
    sys.exit(1)

def emit(key, value):
    print("%s=%s" % (key, shlex.quote(value)))

if not raw:
    mode, name, osver, ident = "name", default_name, default_os, ""
    dest = "platform=iOS Simulator,name=%s,OS=%s" % (name, osver)
else:
    fields = {}
    for part in [item.strip() for item in raw.split(",")]:
        if not part:
            continue
        if "=" not in part:
            fail(
                "unsupported WNF_DESTINATION %r\n"
                "Use platform=iOS Simulator,name=<device>,OS=<version> "
                "or platform=iOS Simulator,id=<udid>" % raw
            )
        key, value = part.split("=", 1)
        key, value = key.strip(), value.strip()
        if not key or key in fields:
            fail("unsupported WNF_DESTINATION %r" % raw)
        fields[key] = value
    unknown = sorted(set(fields) - {"platform", "name", "OS", "id"})
    if unknown:
        fail(
            "unsupported WNF_DESTINATION keys %s in %r\n"
            "Use platform=iOS Simulator,name=<device>,OS=<version> "
            "or platform=iOS Simulator,id=<udid>" % (", ".join(unknown), raw)
        )
    platform = fields.get("platform")
    if platform is not None and platform != "iOS Simulator":
        fail("unsupported WNF_DESTINATION platform %r. Only iOS Simulator is supported." % platform)
    has_id = "id" in fields
    has_name = "name" in fields
    has_os = "OS" in fields
    if has_id and (has_name or has_os):
        fail("WNF_DESTINATION cannot combine id with name or OS: %r" % raw)
    if has_id:
        ident = fields["id"]
        if not ident:
            fail("WNF_DESTINATION id is empty")
        mode, name, osver = "id", "", ""
        dest = "platform=iOS Simulator,id=%s" % ident
    elif has_name or has_os:
        if not (has_name and has_os) or not fields.get("name") or not fields.get("OS"):
            fail("WNF_DESTINATION name mode requires both name and OS: %r" % raw)
        mode, name, osver, ident = "name", fields["name"], fields["OS"], ""
        dest = "platform=iOS Simulator,name=%s,OS=%s" % (name, osver)
    elif platform is not None:
        fail(
            "WNF_DESTINATION %r has no name/OS or id. "
            "Refusing to fall back to the default simulator." % raw
        )
    else:
        fail("unsupported WNF_DESTINATION %r" % raw)

emit("DEST_MODE", mode)
emit("SIM_NAME", name)
emit("IOS_RUNTIME_VERSION", osver)
emit("SIM_ID", ident)
emit("DESTINATION", dest)
PY
)
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    exit "$rc"
  fi
  eval "$assignments"
}

# action is "check" (never create) or "ensure" (name mode may create).
sim_destination_action() {
  local action="$1"
  python3 - "$action" "$DEST_MODE" "$SIM_NAME" "$IOS_RUNTIME_VERSION" "$SIM_ID" <<'PY'
import json, subprocess, sys

action, mode, name, version, ident = sys.argv[1:6]

def simctl_json(*args):
    out = subprocess.check_output(["xcrun", "simctl", *args, "-j"])
    return json.loads(out)

def fail(msg):
    sys.stderr.write(msg + "\n")
    sys.exit(1)

def ios_runtime(item):
    platform = item.get("platform") or ""
    label = item.get("name") or ""
    runtime_id = item.get("identifier") or ""
    return (
        platform == "iOS"
        or label.startswith("iOS ")
        or runtime_id.startswith("com.apple.CoreSimulator.SimRuntime.iOS-")
    )

def find_runtime(expected):
    matches = []
    for item in simctl_json("list", "runtimes").get("runtimes", []):
        if item.get("isAvailable") is not True:
            continue
        if str(item.get("version", "")) != expected:
            continue
        if ios_runtime(item):
            matches.append(item)
    if not matches:
        fail(
            "iOS %s runtime is not installed or is unavailable. "
            "Install it from Xcode Settings > Platforms. "
            "This script will not download Xcode or runtimes." % expected
        )
    if len(matches) > 1:
        fail("multiple available iOS runtimes match version %s exactly" % expected)
    return matches[0]

def find_device_id(device_id):
    found = None
    runtime_id = None
    for rid, devices in simctl_json("list", "devices").get("devices", {}).items():
        for dev in devices:
            if dev.get("udid") == device_id:
                found = dev
                runtime_id = rid
                break
        if found is not None:
            break
    if found is None:
        fail(
            "simulator id %s was not found. "
            "This script will not create the default simulator instead." % device_id
        )
    if found.get("isAvailable") is False or found.get("isUnavailable") is True:
        fail("simulator id %s exists but is unavailable." % device_id)
    runtime = next(
        (item for item in simctl_json("list", "runtimes").get("runtimes", [])
         if item.get("identifier") == runtime_id),
        None,
    )
    if runtime is None or not ios_runtime(runtime) or runtime.get("isAvailable") is not True:
        fail("simulator id %s must use an available iOS runtime." % device_id)
    return found, runtime_id

if mode == "id":
    device, runtime_id = find_device_id(ident)
    print(
        "simulator id %s (%s) runtime %s"
        % (ident, device.get("name") or "unnamed", runtime_id)
    )
    sys.exit(0)

if mode != "name":
    fail("unsupported destination mode %s" % mode)

runtime = find_runtime(version)
types = simctl_json("list", "devicetypes").get("devicetypes", [])
devtype = next((item for item in types if item.get("name") == name), None)
if devtype is None:
    fail("device type %s is not available in this Xcode." % name)

runtime_id = runtime["identifier"]
print("runtime: %s (%s) available" % (runtime.get("name"), runtime_id))
print("device type: %s present" % name)

if action == "check":
    sys.exit(0)
if action != "ensure":
    fail("unsupported simulator action %s" % action)

devices = simctl_json("list", "devices", "available").get("devices", {})
for dev in devices.get(runtime_id, []):
    if dev.get("name") == name and dev.get("isUnavailable") is not True:
        print("simulator already present: %s (%s)" % (name, runtime_id))
        sys.exit(0)

subprocess.check_call(
    ["xcrun", "simctl", "create", name, devtype["identifier"], runtime_id]
)
print("created simulator %s for %s" % (name, runtime_id))
PY
}

check_metal_toolchain() {
  local metal_out="" metal_rc=0
  metal_out=$(xcrun metal --version 2>&1) && metal_rc=0 || metal_rc=$?
  if [[ $metal_rc -ne 0 ]]; then
    printf '%s\n' "$metal_out"
    if command -v xcodebuild >/dev/null 2>&1; then
      xcodebuild -showComponent MetalToolchain || true
    fi
    printf 'Metal toolchain is missing or cannot execute. The metal path can exist while compilation still fails.\n'
    printf 'Install the component, then rerun doctor:\n'
    printf '  xcodebuild -downloadComponent MetalToolchain\n'
    printf 'This script does not download Xcode, runtimes, or the Metal toolchain.\n'
    return 1
  fi
  printf 'metal: %s\n' "$metal_out"
  return 0
}

cmd_doctor() {
  local log="${LOG_DIR}/doctor.log"
  local rc=0
  ensure_dirs
  stage_start doctor "" "$log"
  set +e
  (
    problems=0
    printf 'repo: %s\n' "$REPO_ROOT"
    if [[ -n "${DEVELOPER_DIR:-}" ]]; then
      printf 'developer dir: %s\n' "$DEVELOPER_DIR"
    else
      printf 'developer dir: %s\n' "$(xcode-select -p 2>/dev/null || printf 'unavailable')"
    fi
    printf 'destination: %s\n' "$DESTINATION"
    printf 'destination mode: %s\n' "$DEST_MODE"
    echo
    for cmd in git python3 sips plutil xcrun xcodebuild; do
      if command -v "$cmd" >/dev/null 2>&1; then
        printf 'command: %s\n' "$cmd"
      else
        printf 'missing command: %s\n' "$cmd"
        problems=1
      fi
    done
    echo
    if ! command -v xcodebuild >/dev/null 2>&1; then
      printf 'xcodebuild is required before version, Metal, and simulator checks\n'
      exit 1
    fi
    xcodebuild -version
    echo
    if ! command -v xcrun >/dev/null 2>&1; then
      printf 'xcrun is required before Metal and simulator checks\n'
      exit 1
    fi
    if ! check_metal_toolchain; then
      problems=1
    fi
    echo
    if ! sim_destination_action check; then
      problems=1
    fi
    echo
    if ! xcodebuild -list -project "$PROJECT"; then
      problems=1
    fi
    echo
    if ! check_four_targets; then
      problems=1
    else
      printf 'targets: WNF WNFWidget WNFTests WNFUITests\n'
    fi
    if ! check_tracked_scheme; then
      problems=1
    else
      printf 'tracked scheme: WNF.xcscheme only\n'
    fi
    exit "$problems"
  ) >"$log" 2>&1
  rc=$?
  set -e
  cat "$log"
  if [[ $rc -ne 0 ]]; then
    fail_stage "$rc"
  fi
  stage_finish PASS 0
}

cmd_bootstrap() {
  local log="${LOG_DIR}/bootstrap.log"
  ensure_dirs
  stage_start bootstrap "" "$log"
  set +e
  sim_destination_action ensure >"$log" 2>&1
  local rc=$?
  set -e
  cat "$log"
  if [[ $rc -ne 0 ]]; then
    fail_stage "$rc"
  fi
  stage_finish PASS 0
}

check_project_facts_python() {
  python3 - "$REPO_ROOT" <<'PY'
"""Static checks for scripts/wnf. Run against a repo root."""
import hashlib
import os
import re
import subprocess
import sys

repo = sys.argv[1]
errors = []

def err(msg):
    errors.append(msg)

def parse_pbx(path):
    # Xcode project files are OpenStep plists; use Apple's parser rather than
    # relying on indentation, UUID spelling, or comments in the serialization.
    import json
    payload = subprocess.check_output(["plutil", "-convert", "json", "-o", "-", path])
    return json.loads(payload)["objects"]

def field(body, name):
    return body.get(name, body.get("buildSettings", {}).get(name))

def list_ids(body, name):
    return body.get(name, [])

def unquote(value):
    if value is None:
        return None
    value = value.strip()
    if value.startswith('"') and value.endswith('"'):
        return value[1:-1]
    return value

objects = parse_pbx(os.path.join(repo, "WNF.xcodeproj/project.pbxproj"))

parents = {}
for oid, body in objects.items():
    if body.get("isa") not in ("PBXGroup", "PBXVariantGroup"):
        continue
    for child in list_ids(body, "children"):
        parents[child] = oid

def group_path(oid):
    parts = []
    seen = set()
    current = oid
    while current and current not in seen:
        seen.add(current)
        body = objects.get(current, {})
        path = unquote(field(body, "path"))
        source = unquote(field(body, "sourceTree")) or "<group>"
        if path and source not in ("BUILT_PRODUCTS_DIR", "SDKROOT"):
            parts.append(path)
        if source == "SOURCE_ROOT":
            break
        current = parents.get(current)
    parts.reverse()
    return os.path.normpath(os.path.join(*parts)) if parts else ""

file_paths = {}
for oid, body in objects.items():
    if body.get("isa") != "PBXFileReference":
        continue
    source = unquote(field(body, "sourceTree")) or "<group>"
    path = unquote(field(body, "path"))
    if source == "BUILT_PRODUCTS_DIR" or not path:
        file_paths[oid] = None
        continue
    if source == "SOURCE_ROOT":
        file_paths[oid] = os.path.normpath(path)
        continue
    parent = parents.get(oid)
    base = group_path(parent) if parent else ""
    file_paths[oid] = os.path.normpath(os.path.join(base, path)) if base else os.path.normpath(path)

build_files = {}
for oid, body in objects.items():
    if body.get("isa") != "PBXBuildFile":
        continue
    ref = field(body, "fileRef")
    if ref:
        build_files[oid] = ref.split()[0]

targets = {}
for oid, body in objects.items():
    if body.get("isa") != "PBXNativeTarget":
        continue
    name = unquote(field(body, "name"))
    targets[name] = oid

def phase_files(target_name, isa):
    body = objects[targets[target_name]]
    paths = []
    for phase_id in list_ids(body, "buildPhases"):
        phase = objects[phase_id]
        if phase.get("isa") != isa:
            continue
        for build_id in list_ids(phase, "files"):
            ref = build_files.get(build_id)
            rel = file_paths.get(ref)
            if rel is None:
                err("unresolved %s file %s in %s" % (isa, build_id, target_name))
            paths.append(rel)
    return paths

membership = {}
for target in ("WNF", "WNFWidget", "WNFTests", "WNFUITests"):
    seen = {}
    for rel in phase_files(target, "PBXSourcesBuildPhase"):
        if rel is None:
            continue
        seen.setdefault(rel, 0)
        seen[rel] += 1
        membership.setdefault(rel, set()).add(target)
        full = os.path.join(repo, rel)
        if not os.path.isfile(full):
            err("missing source %s in %s" % (rel, target))
    for rel, count in seen.items():
        if count > 1:
            err("%s compiles %s %d times" % (target, rel, count))
    for rel in phase_files(target, "PBXResourcesBuildPhase"):
        if rel is None:
            continue
        full = os.path.join(repo, rel)
        if not os.path.exists(full):
            err("missing resource %s in %s" % (rel, target))

tracked = subprocess.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard", "*.swift", "*.metal"], cwd=repo, text=True).splitlines()

def expected_targets(rel):
    if rel.startswith("WNFTests/"):
        return {"WNFTests"}
    if rel.startswith("WNFUITests/"):
        return {"WNFUITests"}
    if rel.startswith("WNFWidget/"):
        return {"WNFWidget"}
    if rel == "WNF/WidgetShared.swift":
        return {"WNF", "WNFWidget"}
    if rel.startswith("WNF/") and rel.endswith((".swift", ".metal")):
        return {"WNF"}
    return None

for rel in tracked:
    expect = expected_targets(rel)
    if expect is None:
        continue
    got = membership.get(rel, set())
    if got != expect:
        err("target membership %s expected %s got %s" % (rel, sorted(expect), sorted(got)))

def version_pair(target_name):
    body = objects[targets[target_name]]
    config_list = field(body, "buildConfigurationList").split()[0]
    pairs = {}
    for config_id in list_ids(objects[config_list], "buildConfigurations"):
        config = objects[config_id]
        name = unquote(field(config, "name"))
        marketing = unquote(field(config, "MARKETING_VERSION"))
        build = unquote(field(config, "CURRENT_PROJECT_VERSION"))
        pairs[name] = (marketing, build)
    return pairs

app_versions = version_pair("WNF")
widget_versions = version_pair("WNFWidget")
if set(app_versions) != {"Debug", "Release"} or set(widget_versions) != {"Debug", "Release"}:
    err("WNF/WNFWidget configs are %s / %s" % (sorted(app_versions), sorted(widget_versions)))
else:
    values = list(app_versions.values()) + list(widget_versions.values())
    if any(item is None or "" in item or None in item for item in values):
        err("missing MARKETING_VERSION or CURRENT_PROJECT_VERSION: %s %s" % (app_versions, widget_versions))
    elif len(set(values)) != 1:
        err("WNF and WNFWidget Debug/Release versions differ: %s %s" % (app_versions, widget_versions))

def github_anchor(heading):
    text = heading.strip().lower()
    text = re.sub(r"[^\w\u4e00-\u9fff\- ]", "", text, flags=re.UNICODE)
    text = text.replace(" ", "-")
    return text

def headings(path):
    found = []
    for line in open(path, encoding="utf-8"):
        match = re.match(r"^(#{1,6})\s+(.*)$", line)
        if match:
            found.append(github_anchor(match.group(2)))
    return found

link_re = re.compile(r"!?\[[^\]]*\]\(([^)]+)\)")
for doc in ("README.md", "AGENTS.md"):
    text = open(os.path.join(repo, doc), encoding="utf-8").read()
    for target in link_re.findall(text):
        target = target.strip()
        if target.startswith(("http://", "https://", "mailto:")):
            continue
        path_part, _, anchor = target.partition("#")
        if path_part.startswith("build/") or path_part.startswith("/"):
            err("%s links to non-repo evidence %s" % (doc, target))
            continue
        if not path_part:
            dest = os.path.join(repo, doc)
        else:
            dest = os.path.normpath(os.path.join(repo, os.path.dirname(doc), path_part))
        if not os.path.exists(dest):
            err("%s broken link %s" % (doc, target))
            continue
        if anchor and os.path.isfile(dest) and dest.endswith(".md"):
            if github_anchor(anchor) not in headings(dest) and anchor not in headings(dest):
                err("%s missing anchor %s in %s" % (doc, anchor, path_part or doc))
    if re.search(r"build/verification/visual/", text):
        err("%s depends on untracked visual evidence" % doc)

font_hashes = {
    "WNF/Fonts/ZCOOLQingKeHuangYou-Regular.ttf": None,
    "WNF/Fonts/JetBrainsMono-Regular.ttf": None,
    "WNF/Fonts/JetBrainsMono-Bold.ttf": None,
}
ack_path = os.path.join(repo, "docs/acknowledgements.html")
ack = open(ack_path, encoding="utf-8").read()
for rel in font_hashes:
    digest = hashlib.sha256(open(os.path.join(repo, rel), "rb").read()).hexdigest()
    name = os.path.basename(rel)
    if digest not in ack:
        err("SHA-256 of %s (%s) is not in docs/acknowledgements.html" % (name, digest))

pages = [
    "docs/index.html",
    "docs/privacy.html",
    "docs/terms.html",
    "docs/support.html",
    "docs/acknowledgements.html",
    "docs/.nojekyll",
]
for rel in pages:
    if not os.path.isfile(os.path.join(repo, rel)):
        err("missing site file %s" % rel)

href_re = re.compile(r"""href=["']([^"']+)["']""", re.I)
for rel in pages:
    if not rel.endswith(".html"):
        continue
    text = open(os.path.join(repo, rel), encoding="utf-8").read()
    for href in href_re.findall(text):
        if href.startswith(("http://", "https://", "mailto:", "#")):
            continue
        dest = os.path.normpath(os.path.join(repo, "docs", href.split("#", 1)[0]))
        if not os.path.isfile(dest):
            err("%s broken local link %s" % (rel, href))

if errors:
    sys.stderr.write("\n".join(errors) + "\n")
    sys.exit(1)
print("static extra ok")
print("sources", len(membership))
PY
}

cmd_static_gate() {
  local log="${LOG_DIR}/static-gate.log"
  local rc=0
  ensure_dirs
  stage_start static-gate "" "$log"
  set +e
  (
    set -euo pipefail
    require_cmd git
    require_cmd python3
    require_cmd sips
    require_cmd plutil
    require_cmd xcodebuild
    printf 'working tree + committed branch diff hygiene\n'
    git_diff_check
    printf 'forbidden substrings\n'
    forbidden_needles_python
    printf 'targets + tracked scheme\n'
    check_four_targets
    check_tracked_scheme
    printf 'plist / entitlements / privacy / metadata JSON\n'
    parse_and_check_tree_python
    printf 'onboarding images 1536x1024 + alpha\n'
    check_onboarding_images
    printf 'canonical legal HTML + fonts\n'
    check_canonical_files
    printf 'project membership, versions, doc links, font hashes, site links\n'
    check_project_facts_python
    printf 'metadata 1.0/1.1/1.2 present (parsed above)\n'
  ) >"$log" 2>&1
  rc=$?
  set -e
  cat "$log"
  if [[ $rc -ne 0 ]]; then
    fail_stage "$rc"
  fi
  stage_finish PASS 0
}

cmd_build() {
  run_xcodebuild_stage build Debug build
}

cmd_test_unit() {
  # UI tests in this scheme still compile; complete isolation trips XCTest APIs.
  run_xcodebuild_stage test-unit Debug test -only-testing:WNFTests SWIFT_STRICT_CONCURRENCY=minimal
}

cmd_test_ui() {
  run_xcodebuild_stage test-ui Debug test -only-testing:WNFUITests SWIFT_STRICT_CONCURRENCY=minimal
}

cmd_analyze() {
  run_xcodebuild_stage analyze Debug analyze
}

cmd_release_check() {
  local stage="release-check"
  local log="${LOG_DIR}/${stage}.log"
  local bundle="${RESULT_DIR}/${stage}.xcresult"
  stage_start "$stage" "$bundle" "$log"
  local rc=0
  xcode_common Release "$log" "$bundle" build || rc=$?
  if [[ $rc -ne 0 ]]; then
    fail_stage "$rc"
  fi
  local app=""
  set +e
  app=$(find_release_app)
  rc=$?
  set -e
  if [[ $rc -ne 0 || -z "$app" ]]; then
    printf 'Release .app not found under DerivedData\n' >>"$log"
    fail_stage 1
  fi
  printf 'Release app: %s\n' "$(relpath "$app")" >>"$log"
  set +e
  audit_release_bundle "$app" >>"$log" 2>&1
  rc=$?
  set -e
  if [[ $rc -ne 0 ]]; then
    fail_stage "$rc"
  fi
  stage_finish PASS 0
}

cmd_verify() {
  IN_VERIFY=1
  VERIFY_START=$(now_s)
  ensure_dirs
  cmd_doctor
  cmd_bootstrap
  cmd_static_gate
  cmd_build
  cmd_test_unit
  cmd_test_ui
  cmd_analyze
  cmd_release_check
}

store_check_local() {
  local f
  for f in \
    store/screenshots/01-home.png \
    store/screenshots/02-records.png \
    store/screenshots/03-settings.png \
    store/screenshots/04-share.png \
    docs/privacy.html \
    docs/terms.html \
    docs/support.html \
    docs/acknowledgements.html \
    metadata/version/1.0/zh-Hans.json \
    metadata/version/1.1/zh-Hans.json \
    metadata/version/1.2/zh-Hans.json \
    metadata/app-info/zh-Hans.json
  do
    if [[ ! -f "$f" ]]; then
      printf 'missing %s\n' "$f"
      return 1
    fi
  done
  parse_and_check_tree_python
}

cmd_store_check() {
  local log="${LOG_DIR}/store-check.log"
  local review_dir="${RUN_DIR}/store-check/review"
  local pull_dir="${RUN_DIR}/store-check/pull"
  local rc=0
  ensure_dirs
  mkdir -p "$review_dir" "$pull_dir"
  stage_start store-check "" "$log"
  set +e
  (
    set -euo pipefail
    printf 'local URL + screenshot presence\n'
    store_check_local
    if ! command -v asc >/dev/null 2>&1; then
      printf 'store-check: asc CLI not found. Install and authenticate separately.\n'
      printf 'This command is optional and is not part of ./scripts/wnf verify.\n'
      printf 'Forbidden: metadata apply, submit, remote delete.\n'
      exit 2
    fi
    printf 'asc metadata validate (offline)\n'
    asc metadata validate --dir metadata --pretty
    printf 'asc auth status\n'
    if ! asc auth status; then
      printf 'store-check: ASC authentication failed. Log in with `asc auth login` and retry.\n'
      printf 'This command is optional and is not part of ./scripts/wnf verify.\n'
      printf 'Forbidden: metadata apply, submit, remote delete.\n'
      exit 2
    fi
    printf 'asc metadata pull (temp dir, does not write metadata/)\n'
    asc metadata pull --app "$ASC_APP_ID" --version "$EDITABLE_ASC_VERSION" --platform IOS --dir "$pull_dir" --force
    printf 'asc metadata plan (review artifact under build/verification)\n'
    asc metadata plan --app "$ASC_APP_ID" --version "$EDITABLE_ASC_VERSION" --platform IOS --dir metadata --review-dir "$review_dir"
    printf 'Forbidden operations were not invoked: apply, submit, remote delete.\n'
  ) >"$log" 2>&1
  rc=$?
  set -e
  cat "$log"
  if [[ $rc -ne 0 ]]; then
    fail_stage "$rc"
  fi
  stage_finish PASS 0
}

main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 2
  fi
  case "$1" in
    -h|--help|help)
      usage
      return
      ;;
  esac
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'FAIL  missing command: python3\n'
    exit 1
  fi
  require_cmd git
  resolve_destination
  case "$1" in
    doctor|bootstrap|static-gate|build|test-unit|test-ui|analyze|release-check|verify|store-check)
      begin_run "$1"
      ;;
    *)
      printf 'unknown command: %s\n\n' "$1"
      usage
      exit 2
      ;;
  esac
  case "$1" in
    doctor) cmd_doctor ;;
    bootstrap) cmd_bootstrap ;;
    static-gate) cmd_static_gate ;;
    build) cmd_build ;;
    test-unit) cmd_test_unit ;;
    test-ui) cmd_test_ui ;;
    analyze) cmd_analyze ;;
    release-check) cmd_release_check ;;
    verify) cmd_verify ;;
    store-check) cmd_store_check ;;
    *)
      printf 'unknown command: %s\n\n' "$1"
      usage
      exit 2
      ;;
  esac
}

main "$@"
